def add(a, b):
    return a + b


def is_even(num):
    return num % 2 == 0


def find_max(arr):
    max_val = arr[0]
    for x in arr:
        if x > max_val:
            max_val = x
    return max_val


def reverse_list(arr):
    return arr[::-1]


def count_occurrences(arr, target):
    count = 0
    for x in arr:
        if x == target:
            count += 1
    return count


def sum_of_list(arr):
    total = 0
    for x in arr:
        total += x
    return total


if __name__ == "__main__":
    arr = [1, 2, 1]

    print(add(3, 4))
    print(is_even(10))
    print(find_max(arr))
    print(reverse_list(arr))
    print(count_occurrences(arr, 1))
    print(sum_of_list(arr))
